{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cheetahrunout/cr-agent/protocol/schema.json",
  "title": "CR agent link protocol v1",
  "description": "Frames carried over the agent's WebSocket. proto 1.0. Minor versions add optional fields only.",
  "oneOf": [
    { "$ref": "#/$defs/hello" }, { "$ref": "#/$defs/welcome" }, { "$ref": "#/$defs/reject" },
    { "$ref": "#/$defs/hw" }, { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/cmd" }, { "$ref": "#/$defs/cmdAck" }, { "$ref": "#/$defs/cmdProgress" }, { "$ref": "#/$defs/cmdDone" }, { "$ref": "#/$defs/cmdErr" },
    { "$ref": "#/$defs/req" }, { "$ref": "#/$defs/reqBody" }, { "$ref": "#/$defs/resHead" }, { "$ref": "#/$defs/resData" }, { "$ref": "#/$defs/resEnd" },
    { "$ref": "#/$defs/cancel" }, { "$ref": "#/$defs/ping" }, { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "ulidId": { "type": "string", "pattern": "^[rc]-[0-9A-HJKMNP-TV-Z]{26}$" },
    "modelId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ggufFile": { "type": "string", "pattern": "^(?!.*\\.\\.)(?![^/]*[. ]$)[A-Za-z0-9._-]{1,200}(/[A-Za-z0-9._-]{1,200})?\\.gguf$" },
    "semver": { "type": "string", "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$" },
    "proto": { "type": "string", "pattern": "^\\d+\\.\\d+$" },

    "pool": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "total_mb", "free_mb"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["dedicated", "unified", "host"] },
        "name": { "type": "string" },
        "total_mb": { "type": "integer", "minimum": 0 },
        "free_mb": { "type": "integer", "minimum": 0 },
        "backend": { "enum": ["cuda", "metal", "vulkan", "cpu"] },
        "display": { "type": "boolean" }
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["pools", "cpu", "ram_mb", "disk_free_mb", "os"],
      "properties": {
        "pools": { "type": "array", "items": { "$ref": "#/$defs/pool" } },
        "cpu": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "physical": { "type": "integer" }, "logical": { "type": "integer" } } },
        "ram_mb": { "type": "integer", "minimum": 0 },
        "disk_free_mb": { "type": "integer", "minimum": 0 },
        "disk_total_mb": { "type": "integer", "minimum": 0 },
        "os": { "type": "string" },
        "driver": { "type": "string" },
        "cuda": { "type": "string" },
        "on_battery": { "type": "boolean" }
      }
    },
    "engineState": { "enum": ["unloaded", "loading", "loaded", "unloading", "error"] },
    "jobKind": { "enum": ["download", "inspect", "load", "approval"] },
    "jobState": { "enum": ["running", "awaiting_click", "paused", "done", "failed", "denied"] },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "kind", "state"],
      "properties": {
        "model_id": { "$ref": "#/$defs/modelId" },
        "kind": { "$ref": "#/$defs/jobKind" },
        "state": { "$ref": "#/$defs/jobState" },
        "pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "bytes_done": { "type": "integer", "minimum": 0 },
        "bytes_total": { "type": "integer", "minimum": 0 },
        "awaiting_click": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "localModel": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "repo", "commit", "state"],
      "properties": {
        "model_id": { "$ref": "#/$defs/modelId" },
        "repo": { "$ref": "#/$defs/repo" },
        "commit": { "$ref": "#/$defs/commit" },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": { "path": { "$ref": "#/$defs/ggufFile" }, "size": { "type": "integer" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
        "kind": { "enum": ["gguf", "mmproj"] },
        "state": { "enum": ["downloading", "awaiting_approval", "denied", "ready", "error", "missing", "changed"] },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "settings": {
      "description": "Engine settings the hub sends with load. The agent rejects out-of-bounds values with cmd.err bad_setting (ruling B5).",
      "type": "object", "additionalProperties": false,
      "required": ["ctx", "gpu_layers", "threads", "kv_type", "flash_attn"],
      "properties": {
        "ctx": { "type": "integer", "minimum": 4096, "maximum": 262144 },
        "gpu_layers": { "oneOf": [{ "const": "all" }, { "type": "integer", "minimum": 0, "maximum": 1024 }] },
        "threads": { "type": "integer", "minimum": 1, "maximum": 256 },
        "kv_type": { "enum": ["f16", "q8_0"] },
        "flash_attn": { "enum": ["on", "auto"] },
        "n_cpu_moe": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "chat_template": { "type": "string", "pattern": "^[a-z0-9_-]{1,40}$" },
        "parallel": { "type": "integer", "minimum": 1, "maximum": 4, "description": "slots: people sharing the engine at once, each with ctx / parallel of the cache (ruling B74); an agent without the parallel capability takes only 1" }
      }
    },

    "hello": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "t", "agent_version", "proto", "platform", "backend", "capabilities", "supported_archs", "llama_tag", "hardware", "engine", "models", "jobs", "inflight", "local_pause"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "hello" },
        "agent_version": { "$ref": "#/$defs/semver" },
        "proto": { "$ref": "#/$defs/proto" },
        "platform": { "enum": ["windows-amd64", "linux-amd64", "darwin-arm64"] },
        "backend": { "enum": ["cuda", "metal", "vulkan", "cpu"] },
        "capabilities": { "type": "array", "items": { "enum": ["chunked_bodies", "vision", "config", "inspect", "parallel"] } },
        "supported_archs": { "type": "array", "items": { "type": "string" } },
        "llama_tag": { "type": "string" },
        "hardware": { "$ref": "#/$defs/hardware" },
        "engine": { "$ref": "#/$defs/engineState" },
        "model_id": { "$ref": "#/$defs/modelId" },
        "settings_in_use": { "$ref": "#/$defs/settings" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/localModel" } },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "inflight": { "type": "array", "items": { "$ref": "#/$defs/ulidId" } },
        "last_disconnect_reason": { "type": "string" },
        "local_pause": { "type": "boolean" },
        "hf_token": { "enum": ["absent", "present", "invalid"] },
        "latest_verified_release": { "$ref": "#/$defs/semver" },
        "driver_ok": { "type": "boolean" }
      }
    },
    "welcome": {
      "type": "object", "additionalProperties": true,
      "required": ["v", "t", "proto", "mode", "ping_interval_s", "limits"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "welcome" },
        "proto": { "$ref": "#/$defs/proto" },
        "mode": { "enum": ["normal", "update_required"] },
        "ping_interval_s": { "type": "integer", "minimum": 5, "maximum": 60 },
        "limits": { "type": "object", "properties": { "max_frame": { "type": "integer" }, "max_body": { "type": "integer" } } },
        "hub_version": { "type": "string" },
        "min_agent_version": { "$ref": "#/$defs/semver" }
      }
    },
    "reject": { "type": "object", "additionalProperties": true, "required": ["v", "t", "code"], "properties": { "v": { "const": 1 }, "t": { "const": "reject" }, "code": { "type": "integer" }, "message": { "type": "string" } } },
    "hw": { "type": "object", "additionalProperties": false, "required": ["v", "t", "hardware"], "properties": { "v": { "const": 1 }, "t": { "const": "hw" }, "hardware": { "$ref": "#/$defs/hardware" } } },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "t", "engine", "jobs", "local_pause"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "status" },
        "engine": { "$ref": "#/$defs/engineState" },
        "model_id": { "$ref": "#/$defs/modelId" },
        "engine_error": { "type": "string" },
        "load_pct": { "type": "number" },
        "settings_in_use": { "$ref": "#/$defs/settings" },
        "measured_vram_mb": { "type": "integer" },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "models": { "type": "array", "items": { "$ref": "#/$defs/localModel" } },
        "local_pause": { "type": "boolean" },
        "sleeping": { "type": "boolean" },
        "gpu_pressure_mb": { "type": "integer" },
        "update": { "type": "object", "additionalProperties": false, "properties": { "state": { "enum": ["downloading", "verifying", "installing", "restarting", "failed"] }, "pct": { "type": "number" }, "version": { "$ref": "#/$defs/semver" } } }
      }
    },

    "cmd": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "t", "id", "op", "args"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "cmd" },
        "id": { "$ref": "#/$defs/ulidId" },
        "op": { "enum": ["download", "inspect", "load", "unload", "pause", "resume", "cancel", "delete", "update", "config"] },
        "args": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["model_id", "repo", "commit", "files", "kind"], "properties": { "model_id": { "$ref": "#/$defs/modelId" }, "repo": { "$ref": "#/$defs/repo" }, "commit": { "$ref": "#/$defs/commit" }, "files": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/ggufFile" } }, "kind": { "enum": ["gguf", "mmproj"] } } },
            { "type": "object", "additionalProperties": false, "required": ["repo", "commit", "file"], "properties": { "repo": { "$ref": "#/$defs/repo" }, "commit": { "$ref": "#/$defs/commit" }, "file": { "$ref": "#/$defs/ggufFile" } } },
            { "type": "object", "additionalProperties": false, "required": ["model_id", "settings"], "properties": { "model_id": { "$ref": "#/$defs/modelId" }, "settings": { "$ref": "#/$defs/settings" } } },
            { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/ulidId" } } },
            { "type": "object", "additionalProperties": false, "required": ["model_id"], "properties": { "model_id": { "$ref": "#/$defs/modelId" } } },
            { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "$ref": "#/$defs/semver" } } },
            { "type": "object", "additionalProperties": false, "properties": { "keep_awake": { "type": "boolean" }, "gpu_select": { "type": "string", "pattern": "^(all|[0-7])$" }, "idle_unload_min": { "type": "integer", "minimum": 0, "maximum": 1440 } } },
            { "type": "object", "additionalProperties": false, "maxProperties": 0 }
          ]
        }
      }
    },
    "cmdAck": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id"], "properties": { "v": { "const": 1 }, "t": { "const": "cmd.ack" }, "id": { "$ref": "#/$defs/ulidId" } } },
    "cmdProgress": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id"], "properties": { "v": { "const": 1 }, "t": { "const": "cmd.progress" }, "id": { "$ref": "#/$defs/ulidId" }, "pct": { "type": "number" }, "bytes_done": { "type": "integer" }, "bytes_total": { "type": "integer" }, "state": { "$ref": "#/$defs/jobState" } } },
    "cmdDone": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id"], "properties": { "v": { "const": 1 }, "t": { "const": "cmd.done" }, "id": { "$ref": "#/$defs/ulidId" }, "result": { "type": "object" } } },
    "cmdErr": {
      "type": "object", "additionalProperties": false, "required": ["v", "t", "id", "code"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "cmd.err" }, "id": { "$ref": "#/$defs/ulidId" },
        "code": { "enum": ["bad_setting", "bad_args", "insufficient_vram", "no_space", "denied", "download_failed", "hash_mismatch", "not_found", "busy", "unsupported", "hub_too_old", "update_failed", "engine_failed", "cancelled"] },
        "message": { "type": "string" }, "field": { "type": "string" }, "need_mb": { "type": "integer" }, "free_mb": { "type": "integer" }
      }
    },
    "inspectResult": {
      "type": "object", "additionalProperties": false,
      "required": ["arch", "kv", "tensors_bytes", "split_count"],
      "properties": {
        "arch": { "type": "string" },
        "kv": { "type": "object", "additionalProperties": false, "properties": { "block_count": { "type": "integer" }, "context_length": { "type": "integer" }, "embedding_length": { "type": "integer" }, "head_count": { "type": "integer" }, "head_count_kv": { "type": "integer" }, "key_length": { "type": "integer" }, "value_length": { "type": "integer" }, "sliding_window": { "type": "integer" }, "n_vocab": { "type": "integer" }, "expert_count": { "type": "integer" }, "expert_used_count": { "type": "integer" }, "ssm_state": { "type": "integer" }, "file_type": { "type": "integer" } } },
        "tensors_bytes": { "type": "object", "additionalProperties": false, "properties": { "token_embd": { "type": "integer" }, "output": { "type": "integer" }, "per_layer_repeating": { "type": "integer" }, "total": { "type": "integer" } } },
        "split_count": { "type": "integer", "minimum": 1 }
      }
    },

    "req": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "t", "id", "path", "stream"],
      "properties": {
        "v": { "const": 1 }, "t": { "const": "req" }, "id": { "$ref": "#/$defs/ulidId" },
        "path": { "enum": ["/v1/chat/completions", "/v1/models", "/health"] },
        "stream": { "type": "boolean" },
        "body": { "type": "object" },
        "body_parts": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "reqBody": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id", "seq", "data"], "properties": { "v": { "const": 1 }, "t": { "const": "req.body" }, "id": { "$ref": "#/$defs/ulidId" }, "seq": { "type": "integer", "minimum": 0 }, "data": { "type": "string" } } },
    "resHead": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id", "status"], "properties": { "v": { "const": 1 }, "t": { "const": "res.head" }, "id": { "$ref": "#/$defs/ulidId" }, "status": { "type": "integer" }, "ctype": { "type": "string" } } },
    "resData": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id", "d"], "properties": { "v": { "const": 1 }, "t": { "const": "res.data" }, "id": { "$ref": "#/$defs/ulidId" }, "d": { "type": "array", "items": { "type": "string" } } } },
    "resEnd": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id", "reason"], "properties": { "v": { "const": 1 }, "t": { "const": "res.end" }, "id": { "$ref": "#/$defs/ulidId" }, "reason": { "enum": ["done", "cancelled", "error"] }, "error": { "type": "string" } } },
    "cancel": { "type": "object", "additionalProperties": false, "required": ["v", "t", "id"], "properties": { "v": { "const": 1 }, "t": { "const": "cancel" }, "id": { "$ref": "#/$defs/ulidId" } } },
    "ping": { "type": "object", "additionalProperties": true, "required": ["v", "t", "ts"], "properties": { "v": { "const": 1 }, "t": { "const": "ping" }, "ts": { "type": "integer" } } },
    "pong": { "type": "object", "additionalProperties": true, "required": ["v", "t", "ts"], "properties": { "v": { "const": 1 }, "t": { "const": "pong" }, "ts": { "type": "integer" } } }
  }
}
